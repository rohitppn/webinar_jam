# ---- admin login (browser basic auth) ----
ADMIN_USER=arunav
ADMIN_PASS=pick-a-long-password

# ---- WebinarJam webhook guard ----
WEBHOOK_TOKEN=pick-a-long-random-string

# ---- event ----
EVENT_START=2026-09-18T21:00:00
EVENT_DAY_EXCEPTION=2026-09-18
TZ_NAME=Asia/Kolkata

# ---- throttle: 30 messages, then a 60-minute rest ----
BURST_SIZE=30
BURST_REST_MINUTES=60
MIN_GAP_SECONDS=45
MAX_GAP_SECONDS=110
DAILY_CAP=120
QUIET_START_HOUR=8
QUIET_END_HOUR=23
LATE_WINDOW_END_HOUR=23.5
ONE_PER_CONTACT_PER_DAY=true

# ---- safety ----
DRY_RUN=false
TYPING_SIMULATION=true
DEFAULT_COUNTRY_CODE=91

# ---- google sheets ----
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- links (required — no defaults in code, this repo is public) ----
# Messages that reference these are held until all three are set.
JOIN_LINK=
CALENDLY_LINK=
UPI_ID=
